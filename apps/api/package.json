{
  "name": "@tablemate/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tablemate API: REST, WebSocket, proof verification, Stripe holds, settlement",
  "exports": {
    ".": {
      "tablemate-source": "./src/app.ts",
      "types": "./dist/src/app.d.ts",
      "default": "./dist/src/app.js"
    },
    "./test-support/*": "./test/support/*.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "start": "node --enable-source-maps dist/src/main.js",
    "bench:verify": "tsx --conditions=tablemate-source scripts/bench-verify.ts",
    "perf:seed": "tsx --conditions=tablemate-source scripts/perf-seed.ts",
    "openapi:emit": "tsx --conditions=tablemate-source scripts/emit-openapi.ts",
    "grant-operator": "tsx --conditions=tablemate-source scripts/grant-operator.ts",
    "stripe-proxy": "tsx --conditions=tablemate-source test/support/stripe-proxy/server.ts",
    "voice-sim": "tsx --conditions=tablemate-source test/support/voice-simulator/simulator.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.4.0",
    "@fastify/formbody": "9.0.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/swagger": "9.9.3",
    "@fastify/websocket": "11.3.7",
    "@tablemate/circuits": "workspace:*",
    "@tablemate/db": "workspace:*",
    "@tablemate/server-core": "workspace:*",
    "@tablemate/shared": "workspace:*",
    "bullmq": "6.6.0",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "6.0.0",
    "jose": "6.2.15",
    "luxon": "3.7.2",
    "openapi-types": "12.1.3",
    "opening_hours": "3.15.0",
    "sharp": "0.35.5",
    "snarkjs": "0.7.6",
    "stripe": "23.1.0",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "3.7.6",
    "@types/ws": "8.18.2"
  }
}
