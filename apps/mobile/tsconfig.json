// Type-checking programme for the Expo app: the Metro entry, the Expo Router screens under
// app/, the client code under src/, the local native prover module, the Vitest test and the
// Playwright e2e suite, plus app.config.ts and playwright.config.ts. Run by
// `pnpm --filter @tablemate/mobile typecheck`, which root `pnpm typecheck` delegates to, and
// read by root ESLint's projectService for every one of those files. Metro emits the app, so
// no compiler here ever writes a file.
//
// Four overrides of tsconfig.base.json are load-bearing:
//   - customConditions replaces the base array rather than merging with it, so
//     "tablemate-source" is repeated: workspace packages resolve to their TypeScript source,
//     as Metro, Vitest and tsx resolve them. "react-native" is the condition Expo's own base
//     config carries.
//   - moduleSuffixes selects the .native half of a platform split, and the empty suffix must come
//     first. TypeScript strips the extension of an explicit `.ts` specifier and then applies each
//     suffix in turn, so [".native", ""] would resolve the `.ts` spelling - the workspace's way of
//     naming a module's own file - to its platform twin: `./prover.ts` would land on
//     prover.native.ts, leaving the neutral src/zk/prover.ts unreachable for the platform halves
//     that type-import its contracts, and the pair collides only there, where the neutral file
//     shares the halves' basename. With "" first, an explicit `.ts` specifier keeps naming its own
//     file, which is also how Metro reads one, while an extensionless import (./storage,
//     ./card-setup, ./register) still falls back to the .native variant. The .web files are
//     type-checked in their own right because the include globs cover them, so each pair must
//     satisfy the interface its neutral module declares.
//   - lib omits WebWorker deliberately: WebWorker and DOM cannot coexist in one programme, and
//     the web prover worker types `self`, the OPFS handles and its frames locally instead.
//   - noEmit permits allowImportingTsExtensions, which the relative `.ts` imports of the
//     workspace sources and of the neutral src/zk/prover.ts need.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleSuffixes": ["", ".native"],
    "customConditions": ["tablemate-source", "react-native"],
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node", "expo/types"]
  },
  "include": [
    "index.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "modules/tablemate-prover/index.ts",
    "modules/tablemate-prover/src/**/*.ts",
    "test/**/*.ts",
    "e2e/**/*.ts",
    "app.config.ts",
    "playwright.config.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".expo",
    "ios",
    "android",
    "modules/tablemate-prover/ios",
    "modules/tablemate-prover/android",
    "modules/tablemate-prover/rust",
    "e2e/maestro/**"
  ]
}
