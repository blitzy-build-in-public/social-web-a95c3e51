{
  "name": "@tablemate/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "export:web": "expo export --platform web",
    "e2e:web": "NODE_OPTIONS=--conditions=tablemate-source playwright test -c playwright.config.ts",
    "e2e:prepare": "tsx --conditions=tablemate-source e2e/playwright/support/api-actor.ts prepare-maestro",
    "e2e:native": "pnpm run e2e:prepare && maestro test --include-tags e2e -e API_URL=${E2E_API_URL:-http://localhost:3000} -e MAILPIT_URL=${E2E_MAILPIT_URL:-http://localhost:8025} -e CONSOLE_URL=${E2E_CONSOLE_URL:-http://localhost:8090} -e TEST_CONTROL_TOKEN=${TEST_CONTROL_TOKEN:-} -e STRIPE_MODE=${STRIPE_MODE:-mock} e2e/maestro"
  },
  "dependencies": {
    "@expo/metro-runtime": "4.0.1",
    "@noble/hashes": "2.4.0",
    "@react-native-community/netinfo": "11.4.1",
    "@stripe/react-stripe-js": "7.0.1",
    "@stripe/stripe-js": "10.2.1",
    "@stripe/stripe-react-native": "0.38.6",
    "@tablemate/circuits": "workspace:*",
    "@tablemate/shared": "workspace:*",
    "@tanstack/react-query": "5.105.3",
    "expo": "52.0.49",
    "expo-asset": "11.0.5",
    "expo-build-properties": "0.13.3",
    "expo-camera": "16.0.18",
    "expo-constants": "17.0.8",
    "expo-dev-client": "5.0.20",
    "expo-device": "7.0.3",
    "expo-document-picker": "13.0.3",
    "expo-file-system": "18.0.12",
    "expo-image-picker": "16.0.6",
    "expo-linking": "7.0.5",
    "expo-location": "18.0.10",
    "expo-notifications": "0.29.14",
    "expo-router": "4.0.22",
    "expo-secure-store": "14.0.1",
    "expo-share-intent": "3.2.3",
    "expo-splash-screen": "0.29.24",
    "expo-status-bar": "2.0.1",
    "query-string": "7.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "2.20.2",
    "react-native-get-random-values": "1.11.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "0.19.13",
    "snarkjs": "0.7.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/react": "18.3.31",
    "babel-preset-expo": "12.0.12",
    "expo-module-scripts": "4.0.5"
  }
}
