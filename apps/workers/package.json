{
  "name": "@tablemate/workers",
  "version": "0.1.0",
  "private": true,
  "description": "Tablemate background job service: places, menus, calls, expiry, erasure, notifications.",
  "type": "module",
  "engines": {
    "node": "22.23.4"
  },
  "exports": {
    "./jobs/*": {
      "tablemate-source": "./src/jobs/*.ts",
      "types": "./dist/src/jobs/*.d.ts",
      "default": "./dist/src/jobs/*.js"
    },
    "./queues": {
      "tablemate-source": "./src/queues.ts",
      "types": "./dist/src/queues.d.ts",
      "default": "./dist/src/queues.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "start": "node dist/src/main.js",
    "eval:menus": "tsx --conditions=tablemate-source eval/menus-eval.ts"
  },
  "dependencies": {
    "@tablemate/shared": "workspace:*",
    "@tablemate/db": "workspace:*",
    "@tablemate/server-core": "workspace:*",
    "playwright": "1.64.1",
    "pdfjs-dist": "6.5.438",
    "robots-parser": "3.0.1",
    "sharp": "0.35.5",
    "opening_hours": "3.15.0",
    "nodemailer": "10.3.1",
    "expo-server-sdk": "8.0.0",
    "luxon": "3.7.2",
    "zod": "4.6.7",
    "bullmq": "6.6.0",
    "ioredis": "6.0.0"
  },
  "devDependencies": {
    "@tablemate/api": "workspace:*",
    "@types/luxon": "3.7.6"
  }
}
