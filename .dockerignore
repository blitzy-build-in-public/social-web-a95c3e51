# Docker build-context exclusions, shared by every Tablemate image: each Dockerfile builds with the repository root
# as its context (`context: .` in docker-compose.yml). Manifests, the lockfile, pnpm-workspace.yaml (its overrides
# and patchedDependencies), patches/, tsconfig.base.json, every workspace's sources, config/ and infra/nginx/ stay
# in the context, because the images install the workspace and compile it themselves.

# Version control, editors and OS metadata
.git
.gitignore
.idea
.vscode
**/.DS_Store

# Secrets and local state: an env file is excluded at the root or inside a workspace, at any depth, and only the
# documented template is ever sent to a builder.
**/.env
**/.env.*
!.env.example
.local

# Host installs, compiler output and test reports, from the root or any workspace
**/node_modules
**/dist
**/.tsbuild
**/*.tsbuildinfo
**/coverage
**/test-results
**/playwright-report
**/*.log

# Proving artefacts. The api image carries verification_key.json and no proving key, circuit WASM or witness
# generator, so no context ever holds one: containers receive them only through the compose bind mounts.
packages/circuits/build
packages/circuits/samples
**/*.ptau
**/*.zkey

# Mobile native and Expo output, regenerated by `expo prebuild` and build-native.sh
apps/mobile/.expo
apps/mobile/ios
apps/mobile/android
apps/mobile/dist
apps/mobile/web-build
apps/mobile/modules/tablemate-prover/rust/target
apps/mobile/modules/tablemate-prover/rust/build
apps/mobile/modules/tablemate-prover/rust/MoproiOSBindings
apps/mobile/modules/tablemate-prover/rust/MoproAndroidBindings
apps/mobile/modules/tablemate-prover/rust/Config.toml
apps/mobile/modules/tablemate-prover/ios/Frameworks
apps/mobile/modules/tablemate-prover/ios/Generated
apps/mobile/modules/tablemate-prover/android/src/main/jniLibs
apps/mobile/modules/tablemate-prover/android/src/main/java/uniffi
apps/mobile/modules/tablemate-prover/android/build
**/*.apk
**/*.aab
**/*.ipa

# Host-only material no image reads: documentation, end-to-end specs, the menu evaluation fixtures and the k6
# script, all of which run on the host.
docs
apps/mobile/e2e
apps/workers/eval/fixtures
infra/k6

# Run-harness output kept beside the checkout, which no image reads.
blitzy
