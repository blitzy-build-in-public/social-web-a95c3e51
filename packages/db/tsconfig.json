// The TypeScript project for @tablemate/db (AAP 0.8.1). Everything tsconfig.base.json carries --
// the strict flags, NodeNext resolution, verbatimModuleSyntax, rewriteRelativeImportExtensions and
// the "tablemate-source" condition that resolves @tablemate/shared and @tablemate/server-core to
// their TypeScript sources -- applies here unchanged and is deliberately not restated. Only what
// this workspace adds appears below.
//
// rootDir stays "." so src/index.ts emits dist/src/index.{js,d.ts} and seed/seed.ts emits
// dist/seed/seed.{js,d.ts}, exactly the types/default targets packages/db/package.json `exports`
// maps, and the build info and emitted JavaScript stay under the git-ignored dist. `tsc -b` builds
// the referenced shared and server-core projects first, which is the order this package's imports
// require.
//
// types: ["node"] exists for the seed, which uses node:fs/promises, node:path, node:url and
// node:crypto. prisma/ holds no TypeScript, and the generated Prisma client is reached through
// @prisma/client, so `pnpm db:generate` runs before this project is built.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "types": ["node"]
  },
  // Every TypeScript file of the package is checked, the seed's load-config and secrets-out helpers
  // included, so typescript-eslint's projectService sees them too.
  "include": ["src/**/*.ts", "seed/**/*.ts"],
  "exclude": ["dist", "node_modules"],
  "references": [{ "path": "../shared" }, { "path": "../server-core" }]
}
