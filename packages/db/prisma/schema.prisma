  callTasks        CallTask[]

  @@unique([osmType, osmId])
  @@index([location], type: Gist)
  @@index([cityId])
  // A do-not-call reply looks up every lodging sharing the caller's number by phone (AAP 0.5.3, 0.5.6).
  @@index([phone])
  @@map("lodging")
}

// The single active claim per user is enforced in the API under a per-user advisory lock: it depends on
// stayTo, which no index can express (AAP 0.5.2).
model LodgingClaim {
  id                         String              @id @default(uuid(7)) @db.Uuid
  userId                     String              @map("user_id") @db.Uuid
  lodgingId                  String              @map("lodging_id") @db.Uuid
  stayFrom                   DateTime            @map("stay_from") @db.Date
  stayTo                     DateTime            @map("stay_to") @db.Date
  bookingNameCiphertext      String?             @map("booking_name_ciphertext")
  bookingReferenceCiphertext String?             @map("booking_reference_ciphertext")
  callConsentAt              DateTime            @map("call_consent_at") @db.Timestamptz(6)
  status                     LodgingClaimStatus  @default(pending_call)
  resolvedAt                 DateTime?           @map("resolved_at") @db.Timestamptz(6)
  detailsErasedAt            DateTime?           @map("details_erased_at") @db.Timestamptz(6)
  createdAt                  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  user                       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  lodging                    Lodging             @relation(fields: [lodgingId], references: [id])
  callTasks                  CallTask[]
  visibilities               LodgingVisibility[]

  @@index([userId, status])
  @@index([lodgingId, status])
  @@map("lodging_claim")
}

model LodgingVisibility {
  userId         String       @id @map("user_id") @db.Uuid
  lodgingClaimId String       @map("lodging_claim_id") @db.Uuid
  showStaying    Boolean      @default(false) @map("show_staying")
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lodgingClaim   LodgingClaim @relation(fields: [lodgingClaimId], references: [id], onDelete: Cascade)

  // The claim read joins visibility by lodging_claim_id, and the strip step updates it by the same column (AAP 0.5.2, 0.5.7).
  @@index([lodgingClaimId])
  @@map("lodging_visibility")
}
