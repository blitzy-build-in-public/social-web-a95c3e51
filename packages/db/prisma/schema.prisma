// `id` is generated by the Prisma client (`uuid(7)`), so a raw-SQL INSERT must supply it; every personal field
// is nullable so an erased user remains a tombstone of id and deletedAt alone (AAP 0.5.2).
model User {
  id                   String                @id @default(uuid(7)) @db.Uuid
  emailCiphertext      String?               @map("email_ciphertext")
  emailLookupHash      String?               @unique @map("email_lookup_hash")
  handle               String?               @unique
  avatarSeed           String?               @map("avatar_seed")
  homeCity             String?               @map("home_city") @db.VarChar(80)
  homeCountryCode      String?               @map("home_country_code") @db.Char(2)
  role                 UserRole              @default(traveler)
  ageConfirmedAt       DateTime?             @map("age_confirmed_at") @db.Timestamptz(6)
  termsVersion         String?               @map("terms_version")
  stripeCustomerId     String?               @map("stripe_customer_id")
  deletionRequestedAt  DateTime?             @map("deletion_requested_at") @db.Timestamptz(6)
  deletedAt            DateTime?             @map("deleted_at") @db.Timestamptz(6)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions             Session[]
  itineraryProofs      ItineraryProof[]
  meetupsInitiated     Meetup[]              @relation("MeetupInitiator")
  meetupsReceived      Meetup[]              @relation("MeetupRecipient")
  deposits             Deposit[]
  paymentOperations    PaymentOperation[]
  checkIns             CheckIn[]
  witnessEvents        WitnessEvent[]
  disclosureProfile    DisclosureProfile?
  profilePhoto         ProfilePhoto?
  messages             Message[]
  disputesFiled        Dispute[]
  blocksMade           Block[]               @relation("BlockBlocker")
  blocksReceived       Block[]               @relation("BlockBlocked")
  reportsMade          Report[]              @relation("ReportReporter")
  reportsReceived      Report[]              @relation("ReportReported")
  tableCreditEntries   TableCreditEntry[]
  experimentAssignment ExperimentAssignment?
  pushTokens           PushToken[]
  operatorAccessLogs   OperatorAccessLog[]
  lodgingClaims        LodgingClaim[]
  lodgingVisibility    LodgingVisibility?

  @@map("user")
}

model Session {
  id                       String    @id @default(uuid(7)) @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  refreshTokenHash         String    @unique @map("refresh_token_hash")
  previousRefreshTokenHash String?   @unique @map("previous_refresh_token_hash")
  expiresAt                DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt                DateTime? @map("revoked_at") @db.Timestamptz(6)
  rotatedAt                DateTime? @map("rotated_at") @db.Timestamptz(6)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // Sessions are purged 24 h after expiry by data-expiry (AAP 0.5.2), as magic_link_token is by its own expires_at index.
  @@index([expiresAt])
  @@map("session")
}

model MagicLinkToken {
  id                      String    @id @default(uuid(7)) @db.Uuid
  tokenHash               String    @unique @map("token_hash")
  emailCiphertext         String    @map("email_ciphertext")
  emailLookupHash         String    @map("email_lookup_hash")
  // The raw token for the mailer: nulled once the link is sent, or unsent once the token has expired (AAP 0.3.2).
  deliveryTokenCiphertext String?   @map("delivery_token_ciphertext")
  expiresAt               DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt                  DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([emailLookupHash, createdAt])
  @@index([expiresAt])
  @@map("magic_link_token")
}

model City {
  // The primary key is the city slug itself (AAP 0.5.2): `id` holds `lisbon`, `mexico-city`,
  // `medellin`, `chiang-mai` and `canggu`, the value every `:cityId` parameter, `CityDto.id` and
  // `config/cities.json` carry. The column is named `id`, not `slug`.
  id              String                                @id
  circuitCityId   Int                                   @unique @map("circuit_city_id")
  name            String
  countryCode     String                                @map("country_code") @db.Char(2)
  timezone        String
  callLanguage    String                                @map("call_language")
  currency        String                                @db.Char(3)
  centroid        Unsupported("geography(Point,4326)")?
  // The lodging ingestion area (AAP 0.5.2): exactly the `bbox` object of `config/cities.json`,
  // `{ south, west, north, east }`, as the shared `Bbox` schema validates it.
  bbox            Json
  createdAt       DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  venues          Venue[]
  places          Place[]
  lodgings        Lodging[]
  itineraryProofs ItineraryProof[]

  @@index([centroid], type: Gist)
  @@map("city")
}

model Venue {
  id               String                                @id @default(uuid(7)) @db.Uuid
  cityId           String                                @map("city_id")
  placeId          String?                               @map("place_id") @db.Uuid
  name             String
  address          String
  location         Unsupported("geography(Point,4326)")?
  isActivePartner  Boolean                               @default(true) @map("is_active_partner")
  isFixture        Boolean                               @default(false) @map("is_fixture")
  secretLookupHash String?                               @unique @map("secret_lookup_hash")
  secretCiphertext String?                               @map("secret_ciphertext")
  secretIssuedAt   DateTime?                             @map("secret_issued_at") @db.Timestamptz(6)
  createdAt        DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(6)
  city             City                                  @relation(fields: [cityId], references: [id])
  place            Place?                                @relation(fields: [placeId], references: [id], onDelete: SetNull)
  meetups          Meetup[]

  @@index([location], type: Gist)
  @@index([cityId, isActivePartner])
  // The suggestions candidate statement runs a correlated EXISTS on place_id per candidate place (AAP 0.5.7).
  @@index([placeId])
  @@map("venue")
}

model ItineraryProof {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  cityId        String   @map("city_id")
  arrivalDate   DateTime @map("arrival_date") @db.Date
  departureDate DateTime @map("departure_date") @db.Date
  issuerId      BigInt   @map("issuer_id")
  nullifier     String   @unique
  validFrom     DateTime @map("valid_from") @db.Timestamptz(6)
  validTo       DateTime @map("valid_to") @db.Timestamptz(6)
  registryRoot  String   @map("registry_root")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city          City     @relation(fields: [cityId], references: [id])

  @@index([cityId, validTo])
  @@index([userId])
  @@map("itinerary_proof")
}

// No user link: a spent nullifier survives account erasure so a booking cannot be proved twice (AAP 0.5.2).
model SpentNullifier {
  nullifier String   @id
  spentAt   DateTime @map("spent_at") @db.Timestamptz(6)

  @@map("spent_nullifier")
}

// One open meetup per pair: partial unique index meetup_open_pair_key in the init migration.
model Meetup {
  id                       String             @id @default(uuid(7)) @db.Uuid
  initiatorId              String             @map("initiator_id") @db.Uuid
  recipientId              String             @map("recipient_id") @db.Uuid
  venueId                  String             @map("venue_id") @db.Uuid
  startsAt                 DateTime           @map("starts_at") @db.Timestamptz(6)
  depositCents             Int                @map("deposit_cents")
  status                   MeetupStatus       @default(proposed)
  cancelReason             CancelReason?      @map("cancel_reason")
  forfeitReason            ForfeitReason?     @map("forfeit_reason")
  variantPairing           VariantPairing     @map("variant_pairing")
  lockedAt                 DateTime?          @map("locked_at") @db.Timestamptz(6)
  proposalVisibleAt        DateTime?          @map("proposal_visible_at") @db.Timestamptz(6)
  recipientDeadline        DateTime?          @map("recipient_deadline") @db.Timestamptz(6)
  recipientViewedAt        DateTime?          @map("recipient_viewed_at") @db.Timestamptz(6)
  recipientAcceptedAt      DateTime?          @map("recipient_accepted_at") @db.Timestamptz(6)
  bothCheckedInAt          DateTime?          @map("both_checked_in_at") @db.Timestamptz(6)
  suggestionsFirstViewedAt DateTime?          @map("suggestions_first_viewed_at") @db.Timestamptz(6)
  budgetCents              Int?               @map("budget_cents")
  budgetUpdatedBy          String?            @map("budget_updated_by") @db.Uuid
  settledAt                DateTime?          @map("settled_at") @db.Timestamptz(6)
  finalAt                  DateTime?          @map("final_at") @db.Timestamptz(6)
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  initiator                User               @relation("MeetupInitiator", fields: [initiatorId], references: [id])
  recipient                User               @relation("MeetupRecipient", fields: [recipientId], references: [id])
  venue                    Venue              @relation(fields: [venueId], references: [id])
  deposits                 Deposit[]
  checkIns                 CheckIn[]
  witnessEvents            WitnessEvent[]
  settlement               MeetupSettlement?
  messages                 Message[]
  disputes                 Dispute[]
  reports                  Report[]
  tableCreditEntries       TableCreditEntry[]

  @@index([status, startsAt])
  @@index([initiatorId])
  @@index([recipientId])
  @@index([venueId])
  // Every meetup metric range-filters starts_at alone (AAP 0.5.7); the composite above cannot be seeked without status.
  @@index([startsAt])
  // The 7-year financial purge selects the batch it deletes by ranging over final_at (AAP 0.5.2).
  @@index([finalAt])
  @@map("meetup")
}

model Deposit {
  id                     String             @id @default(uuid(7)) @db.Uuid
  meetupId               String             @map("meetup_id") @db.Uuid
  ownerId                String             @map("owner_id") @db.Uuid
  role                   ParticipantRole
  status                 DepositStatus      @default(pending)
  amountCents            Int                @map("amount_cents")
  currentAttempt         Int                @default(1) @map("current_attempt")
  currentPaymentIntentId String?            @unique @map("current_payment_intent_id")
  captureBefore          DateTime?          @map("capture_before") @db.Timestamptz(6)
  canceledAt             DateTime?          @map("canceled_at") @db.Timestamptz(6)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  meetup                 Meetup             @relation(fields: [meetupId], references: [id], onDelete: Cascade)
  owner                  User               @relation(fields: [ownerId], references: [id])
  operations             PaymentOperation[]

  @@unique([meetupId, ownerId])
  // The financial purge asks whether a deposit still references a user by owner_id (AAP 0.5.2); the unique above has it trailing.
  @@index([ownerId])
  @@map("deposit")
}

model PaymentOperation {
  id               String                 @id @default(uuid(7)) @db.Uuid
  userId           String                 @map("user_id") @db.Uuid
  depositId        String?                @map("deposit_id") @db.Uuid
  kind             PaymentOperationKind
  attempt          Int?
  seq              Int
  dependsOnId      String?                @map("depends_on_id") @db.Uuid
  paymentIntentId  String?                @map("payment_intent_id")
  stripeCustomerId String?                @map("stripe_customer_id")
  idempotencyKey   String                 @unique @map("idempotency_key")
  status           PaymentOperationStatus @default(pending)
  claimedAt        DateTime?              @map("claimed_at") @db.Timestamptz(6)
  tries            Int                    @default(0)
  lastError        String?                @map("last_error")
  completedAt      DateTime?              @map("completed_at") @db.Timestamptz(6)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  user             User                   @relation(fields: [userId], references: [id])
  deposit          Deposit?               @relation(fields: [depositId], references: [id], onDelete: Cascade)

  @@index([depositId, seq])
  @@index([paymentIntentId])
  @@index([status])
  // The tombstone reference checks and the executor's user scope read operations by user_id (AAP 0.5.2).
  @@index([userId])
  @@map("payment_operation")
}

// Undispatched rows: partial index outbox_message_undispatched_idx in the init migration.
model OutboxMessage {
  id           String     @id @default(uuid(7)) @db.Uuid
  kind         OutboxKind
  payload      Json
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  dispatchedAt DateTime?  @map("dispatched_at") @db.Timestamptz(6)
  tries        Int        @default(0)

  @@map("outbox_message")
}

// Coordinates are never stored (AAP 0.5.2); one pass per user via partial unique index check_in_pass_key.
model CheckIn {
  id             String          @id @default(uuid(7)) @db.Uuid
  meetupId       String          @map("meetup_id") @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  result         CheckInResult
  distanceBucket DistanceBucket? @map("distance_bucket")
  failureCode    String?         @map("failure_code")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  meetup         Meetup          @relation(fields: [meetupId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id])

  @@index([meetupId])
  // The tombstone reference checks ask whether a check-in still references a user by user_id (AAP 0.5.2).
  @@index([userId])
  @@map("check_in")
}

model WitnessEvent {
  id                  String   @id @default(uuid(7)) @db.Uuid
  meetupId            String?  @map("meetup_id") @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  counterpartId       String   @map("counterpart_id") @db.Uuid
  venueId             String   @map("venue_id") @db.Uuid
  cityId              String   @map("city_id")
  completedAt         DateTime @map("completed_at") @db.Timestamptz(6)
  countsForReputation Boolean  @map("counts_for_reputation")
  meetup              Meetup?  @relation(fields: [meetupId], references: [id], onDelete: SetNull)
  user                User     @relation(fields: [userId], references: [id])

  @@unique([meetupId, userId])
  @@index([userId, completedAt])
  @@map("witness_event")
}

model PairHistory {
  userLowId        String   @map("user_low_id") @db.Uuid
  userHighId       String   @map("user_high_id") @db.Uuid
  completedCount   Int      @default(0) @map("completed_count")
  firstCompletedAt DateTime @map("first_completed_at") @db.Timestamptz(6)
  lastCompletedAt  DateTime @map("last_completed_at") @db.Timestamptz(6)

  @@id([userLowId, userHighId])
  @@map("pair_history")
}

model MeetupSettlement {
  meetupId         String            @id @map("meetup_id") @db.Uuid
  outcome          SettlementOutcome
  status           SettlementStatus  @default(applying)
  initiatorPresent Boolean           @map("initiator_present")
  recipientPresent Boolean           @map("recipient_present")
  appliedAt        DateTime          @map("applied_at") @db.Timestamptz(6)
  completedAt      DateTime?         @map("completed_at") @db.Timestamptz(6)
  meetup           Meetup            @relation(fields: [meetupId], references: [id], onDelete: Cascade)

  @@map("meetup_settlement")
}

model DisclosureProfile {
  userId                    String   @id @map("user_id") @db.Uuid
  interestTags              String[] @default([]) @map("interest_tags")
  nickname                  String?  @db.VarChar(40)
  bio                       String?  @db.VarChar(280)
  fullNameCiphertext        String?  @map("full_name_ciphertext")
  externalContactCiphertext String?  @map("external_contact_ciphertext")
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("disclosure_profile")
}

model ProfilePhoto {
  userId    String   @id @map("user_id") @db.Uuid
  webp      Bytes
  width     Int
  height    Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profile_photo")
}

model Message {
  id        String   @id @default(uuid(7)) @db.Uuid
  meetupId  String   @map("meetup_id") @db.Uuid
  senderId  String   @map("sender_id") @db.Uuid
  body      String   @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  meetup    Meetup   @relation(fields: [meetupId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id])

  @@index([meetupId, createdAt])
  // The tombstone reference checks ask whether a message still references a user by sender_id (AAP 0.5.2).
  @@index([senderId])
  @@map("message")
}

// One open dispute per meetup: partial unique index dispute_open_key in the init migration.
model Dispute {
  id             String                 @id @default(uuid(7)) @db.Uuid
  meetupId       String                 @map("meetup_id") @db.Uuid
  filedById      String                 @map("filed_by_id") @db.Uuid
  kind           DisputeKind            @default(other)
  reason         String                 @db.VarChar(500)
  status         DisputeStatus          @default(open)
  outcome        DisputeOutcome?
  resolutionNote DisputeResolutionNote? @map("resolution_note")
  openedAt       DateTime               @map("opened_at") @db.Timestamptz(6)
  deadlineAt     DateTime               @map("deadline_at") @db.Timestamptz(6)
  escalatedAt    DateTime?              @map("escalated_at") @db.Timestamptz(6)
  resolvedAt     DateTime?              @map("resolved_at") @db.Timestamptz(6)
  meetup         Meetup                 @relation(fields: [meetupId], references: [id], onDelete: Cascade)
  filedBy        User                   @relation(fields: [filedById], references: [id])

  @@index([status, deadlineAt])
  // The tombstone reference checks ask whether a dispute still references a user by filed_by_id (AAP 0.5.2).
  @@index([filedById])
  @@map("dispute")
}

model Block {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  blocker   User     @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("block")
}

model Report {
  id         String   @id @default(uuid(7)) @db.Uuid
  reporterId String   @map("reporter_id") @db.Uuid
  reportedId String   @map("reported_id") @db.Uuid
  reason     String   @db.VarChar(500)
  meetupId   String?  @map("meetup_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  reporter   User     @relation("ReportReporter", fields: [reporterId], references: [id])
  reported   User     @relation("ReportReported", fields: [reportedId], references: [id])
  meetup     Meetup?  @relation(fields: [meetupId], references: [id], onDelete: SetNull)

  // The 180-day reason-text clearance ranges over created_at (AAP 0.5.2).
  @@index([createdAt])
  // The tombstone reference checks ask whether a report still names a user by reporter_id (AAP 0.5.2).
  @@index([reporterId])
  // The same checks ask it by reported_id, the other side of the same row (AAP 0.5.2).
  @@index([reportedId])
  // The financial purge nulls the meetup link on reports whose meetup it deletes (AAP 0.5.2).
  @@index([meetupId])
  @@map("report")
}

model TableCreditEntry {
  id          String     @id @default(uuid(7)) @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  meetupId    String     @map("meetup_id") @db.Uuid
  kind        CreditKind
  amountCents Int        @map("amount_cents")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User       @relation(fields: [userId], references: [id])
  meetup      Meetup     @relation(fields: [meetupId], references: [id], onDelete: Cascade)

  @@unique([meetupId, userId, kind])
  @@index([userId])
  @@map("table_credit_entry")
}

model ExperimentAssignment {
  assignmentId      String   @id @default(uuid(7)) @map("assignment_id") @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  variant           Variant
  shareAtAssignment Float    @map("share_at_assignment")
  assignedAt        DateTime @map("assigned_at") @db.Timestamptz(6)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("experiment_assignment")
}

// No FK to User or Meetup: an event is unlinked on erasure instead (AAP 0.5.2).
model AnalyticsEvent {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String
  actorHash    String?  @map("actor_hash")
  cityId       String?  @map("city_id")
  variant      Variant?
  assignmentId String?  @map("assignment_id") @db.Uuid
  meetupId     String?  @map("meetup_id") @db.Uuid
  props        Json     @default("{}")
  occurredAt   DateTime @map("occurred_at") @db.Timestamptz(6)

  @@index([name, occurredAt])
  @@index([actorHash])
  // The metric ranges filter occurred_at alone, which the composite above cannot serve (AAP 0.5.7).
  @@index([occurredAt])
  @@map("analytics_event")
}

model PushToken {
  id        String       @id @default(uuid(7)) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  token     String       @unique
  platform  PushPlatform
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Notifications read push_token by user_id on every send (AAP 0.5.6).
  @@index([userId])
  @@map("push_token")
}

model StripeEvent {
  id          String            @id
  type        String
  status      StripeEventStatus @default(received)
  receivedAt  DateTime          @map("received_at") @db.Timestamptz(6)
  processedAt DateTime?         @map("processed_at") @db.Timestamptz(6)

  // The daily purge deletes stripe_event rows by received_at, the webhook dedupe clock (AAP 0.5.2).
  @@index([receivedAt])
  @@map("stripe_event")
}

// The attempt link lets the strip step delete a lodging call's callbacks (AAP 0.5.2).
model VoiceCallbackEvent {
  id             String      @id @default(uuid(7)) @db.Uuid
  callAttemptId  String      @map("call_attempt_id") @db.Uuid
  callSid        String      @map("call_sid")
  callStatus     String      @map("call_status")
  sequenceNumber Int         @map("sequence_number")
  receivedAt     DateTime    @map("received_at") @db.Timestamptz(6)
  callAttempt    CallAttempt @relation(fields: [callAttemptId], references: [id], onDelete: Cascade)

  @@unique([callSid, callStatus, sequenceNumber])
  // The metadata strip deletes a call's callbacks by call_attempt_id (AAP 0.5.2).
  @@index([callAttemptId])
  @@map("voice_callback_event")
}

model Place {
  id                      String                                @id @default(uuid(7)) @db.Uuid
  osmType                 String?                               @map("osm_type")
  osmId                   BigInt?                               @map("osm_id")
  cityId                  String                                @map("city_id")
  name                    String
  category                PlaceCategory
  location                Unsupported("geography(Point,4326)")?
  website                 String?
  menuUrl                 String?                               @map("menu_url")
  phone                   String?
  openingHours            String?                               @map("opening_hours")
  doNotCall               Boolean                               @default(false) @map("do_not_call")
  isFixture               Boolean                               @default(false) @map("is_fixture")
  nearestPartnerDistanceM Int?                                  @map("nearest_partner_distance_m")
  createdAt               DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(6)
  city                    City                                  @relation(fields: [cityId], references: [id])
  venues                  Venue[]
  priceRecords            PriceRecord[]
  callTasks               CallTask[]

  @@unique([osmType, osmId])
  @@index([location], type: Gist)
  @@index([cityId])
  // A do-not-call reply looks up every place sharing the caller's number by phone (AAP 0.5.3, 0.5.6).
  @@index([phone])
  @@map("place")
}

model PriceRecord {
  id               String       @id @default(uuid(7)) @db.Uuid
  placeId          String       @map("place_id") @db.Uuid
  captureBatchId   String       @map("capture_batch_id") @db.Uuid
  itemName         String       @map("item_name")
  normalizedName   String       @map("normalized_name")
  itemCategory     ItemCategory @map("item_category")
  alcoholic        Boolean?
  perPerson        Boolean?     @map("per_person")
  ticketType       TicketType?  @map("ticket_type")
  priceText        String       @map("price_text")
  localAmountMinor Int          @map("local_amount_minor")
  currency         String       @db.Char(3)
  priceUsdCents    Int          @map("price_usd_cents")
  source           PriceSource
  sourceUrl        String       @map("source_url")
  capturedAt       DateTime     @map("captured_at") @db.Timestamptz(6)
  fxDate           DateTime     @map("fx_date") @db.Date
  confidence       Confidence?
  reviewStatus     ReviewStatus @default(approved) @map("review_status")
  isFixture        Boolean      @default(false) @map("is_fixture")
  place            Place        @relation(fields: [placeId], references: [id], onDelete: Cascade)

  // local_amount_minor and price_usd_cents carry the hand-written CHECK price_record_amount_nonnegative_chk in
  // migration 20261106000000_index_and_money_check (AAP 0.11.1: money is always integer USD cents, never negative).
  // Prisma 6.19.3 cannot model a check constraint, exactly as the init migration's hand-added block documents for
  // call_task_one_target_chk.
  @@index([placeId, source, capturedAt])
  @@map("price_record")
}

model CrawlDomainPolicy {
  domain       String        @id
  decision     CrawlDecision
  reason       String
  checkedAt    DateTime      @map("checked_at") @db.Timestamptz(6)
  overriddenBy String?       @map("overridden_by")

  @@map("crawl_domain_policy")
}

// No user ids: a fact survives claim deletion and account erasure, so historical scores do not change (AAP 0.5.7).
model LodgingActivityFact {
  id          String   @id @default(uuid(7)) @db.Uuid
  lodgingId   String   @map("lodging_id") @db.Uuid
  meetupId    String   @map("meetup_id") @db.Uuid
  pairKey     String   @map("pair_key")
  completedAt DateTime @map("completed_at") @db.Timestamptz(6)
  lodging     Lodging  @relation(fields: [lodgingId], references: [id], onDelete: Cascade)

  @@unique([lodgingId, meetupId])
  @@index([lodgingId, completedAt])
  // The 120-day fact purge ranges over completed_at alone, which the composite above cannot serve (AAP 0.5.2).
  @@index([completedAt])
  @@map("lodging_activity_fact")
}

// The claim id has no FK: the claim is erased, this audit log is kept 365 days.
model OperatorAccessLog {
  id             String                @id @default(uuid(7)) @db.Uuid
  operatorId     String                @map("operator_id") @db.Uuid
  lodgingClaimId String                @map("lodging_claim_id") @db.Uuid
  accessedAt     DateTime              @map("accessed_at") @db.Timestamptz(6)
  purpose        OperatorAccessPurpose
  operator       User                  @relation(fields: [operatorId], references: [id])

  // The 365-day audit purge ranges over accessed_at (AAP 0.5.2).
  @@index([accessedAt])
  // The tombstone reference checks ask whether the log still references a user by operator_id (AAP 0.5.2).
  @@index([operatorId])
  @@map("operator_access_log")
}

model FxRate {
  date       DateTime @db.Date
  currency   String   @db.Char(3)
  usdPerUnit Decimal  @map("usd_per_unit") @db.Decimal(20, 10)

  @@id([date, currency])
  @@map("fx_rate")
}

// Exactly one of place/lodging: check constraint call_task_one_target_chk in the init migration, which the
// explicit Restrict on both targets keeps satisfiable (the optional-relation default would be SetNull).
model CallTask {
  id             String         @id @default(uuid(7)) @db.Uuid
  kind           CallTaskKind
  placeId        String?        @map("place_id") @db.Uuid
  lodgingId      String?        @map("lodging_id") @db.Uuid
  lodgingClaimId String?        @map("lodging_claim_id") @db.Uuid
  status         CallTaskStatus @default(queued)
  attempts       Int            @default(0)
  vendorFailures Int            @default(0) @map("vendor_failures")
  nextAttemptAt  DateTime       @map("next_attempt_at") @db.Timestamptz(6)
  outcomeAt      DateTime?      @map("outcome_at") @db.Timestamptz(6)
  blockedReason  BlockedReason? @map("blocked_reason")
  priority       Int            @default(0)
  resolvedBy     ResolvedBy?    @map("resolved_by")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  place          Place?         @relation(fields: [placeId], references: [id], onDelete: Restrict)
  lodging        Lodging?       @relation(fields: [lodgingId], references: [id], onDelete: Restrict)
  lodgingClaim   LodgingClaim?  @relation(fields: [lodgingClaimId], references: [id], onDelete: SetNull)
  callAttempts   CallAttempt[]

  @@index([status, nextAttemptAt])
  @@index([placeId])
  @@index([lodgingId])
  // The 365-day call-metadata purge selects tasks by kind (AAP 0.5.2).
  @@index([kind])
  // Both claim-resolution paths read call_task by lodging_claim_id (AAP 0.5.3).
  @@index([lodgingClaimId])
  // The outcome metric ranges over outcome_at and the operator queue orders by it (AAP 0.5.7).
  @@index([outcomeAt])
  @@map("call_task")
}

model CallAttempt {
  id                  String               @id @default(uuid(7)) @db.Uuid
  callTaskId          String               @map("call_task_id") @db.Uuid
  twilioCallSid       String?              @unique @map("twilio_call_sid")
  state               CallAttemptState     @default(dispatching)
  superseded          Boolean              @default(false)
  twilioFinalStatus   String?              @map("twilio_final_status")
  outcome             CallAttemptOutcome?
  extractedFields     Json?                @map("extracted_fields")
  summary             String?
  confidence          Confidence?
  // Menu calls only: always null for a lodging call, whose transcript is never stored (AAP 0.5.6).
  transcript          String?
  transcriptDeleteAt  DateTime?            @map("transcript_delete_at") @db.Timestamptz(6)
  durationSec         Int?                 @map("duration_sec")
  startedAt           DateTime             @map("started_at") @db.Timestamptz(6)
  endedAt             DateTime?            @map("ended_at") @db.Timestamptz(6)
  llmReservedMicros   BigInt               @default(0) @map("llm_reserved_micros")
  callTask            CallTask             @relation(fields: [callTaskId], references: [id], onDelete: Cascade)
  voiceCallbackEvents VoiceCallbackEvent[]

  @@index([callTaskId])
  @@index([state])
  // The 30-day transcript clearance ranges over transcript_delete_at (AAP 0.5.2).
  @@index([transcriptDeleteAt])
  @@map("call_attempt")
}

// Column names are a raw-SQL contract with packages/server-core/src/llm/spend.ts and apps/workers/src/calls/caps.ts.
model CallBudgetDay {
  cityId            String   @map("city_id")
  localDate         DateTime @map("local_date") @db.Date
  calls             Int      @default(0)
  llmSpendMicros    BigInt   @default(0) @map("llm_spend_micros")
  llmReservedMicros BigInt   @default(0) @map("llm_reserved_micros")

  @@id([cityId, localDate])
  @@map("call_budget_day")
}

model Lodging {
  id               String                                @id @default(uuid(7)) @db.Uuid
  cityId           String                                @map("city_id")
  osmType          String?                               @map("osm_type")
  osmId            BigInt?                               @map("osm_id")
  name             String
  kind             LodgingKind
  address          String?
  phone            String?
  phoneSource      PhoneSource                           @default(osm) @map("phone_source")
  location         Unsupported("geography(Point,4326)")?
  doNotCall        Boolean                               @default(false) @map("do_not_call")
  isFixture        Boolean                               @default(false) @map("is_fixture")
  osmMissingAt     DateTime?                             @map("osm_missing_at") @db.Timestamptz(6)
  secretLookupHash String?                               @unique @map("secret_lookup_hash")
  secretCiphertext String?                               @map("secret_ciphertext")
  secretIssuedAt   DateTime?                             @map("secret_issued_at") @db.Timestamptz(6)
  createdAt        DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(6)
  city             City                                  @relation(fields: [cityId], references: [id])
  claims           LodgingClaim[]
