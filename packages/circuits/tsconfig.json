// The TypeScript project for @tablemate/circuits: everything tsconfig.base.json carries — the strict flags, NodeNext
// resolution, verbatimModuleSyntax, rewriteRelativeImportExtensions and the load-bearing "tablemate-source" condition
// that resolves @tablemate/shared to its TypeScript source — applies here unchanged and is deliberately not restated.
//
// rootDir stays "." so src/index.ts emits dist/src/index.js, the layout package.json `exports` maps; scripts/ and test/
// emit under the same root, and the build info lives under the git-ignored dist.
//
// types: ["node"] exists for scripts/*.ts and test/**, which use node:fs, node:crypto, node:dns, node:child_process and
// node:module (createRequire, for the untyped snarkjs 0.7.6 and circom_tester 0.0.24). Node globals are therefore
// visible to src/** too, and client safety rests instead on the root ESLint rule over packages/circuits/src/** (no Node
// built-ins, no Buffer, no @zk-email/helpers) and on `expo export`, which fails on an unresolved built-in. lib is ES2023
// with no DOM, so src/** may use only ECMAScript built-ins, Uint8Array and BigInt.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "lib": ["ES2023"],
    "types": ["node"]
  },
  // .circom, .sh and .eml files are not TypeScript, so they stay out of the project; every .ts file in the package is
  // included, which is also what typescript-eslint's projectService needs.
  "include": ["src/**/*.ts", "scripts/*.ts", "test/**/*.ts"],
  "exclude": ["dist", "build", "samples", "node_modules"],
  "references": [{ "path": "../shared" }]
}
