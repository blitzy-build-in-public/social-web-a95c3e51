diff --git a/lib/pbxProject.js b/lib/pbxProject.js
index 068548ab89dfd2d39f90d46d881c17dc86f90bf4..e60ad787d1a7d81d48ca2df799c0654f8fdc5480 100644
--- a/lib/pbxProject.js
