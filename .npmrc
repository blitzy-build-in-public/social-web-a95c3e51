# Exact version pins: every dependency is declared at its resolved version and no range.
save-exact=true
#
# Note for pnpm 12: it reads only authentication settings from .npmrc, so saveExact,
# nodeLinker, shellEmulator, the snarkjs override and the build-script allowlist all live
# in pnpm-workspace.yaml. `save-exact` above is kept for npm-compatible tools only (npx,
# or `expo install` falling back to npm).
