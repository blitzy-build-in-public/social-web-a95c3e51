# Tablemate environment template.
#
# Copy it and replace every <PLACEHOLDER>: `cp .env.example .env`. Docker Compose reads `.env` for
# interpolation and passes its values into the `postgres`, `api`, `workers` and `migrate` services;
# `apps/venue-console/vite.config.ts` and `apps/mobile/app.config.ts` read the same file at build
# time through their `VITE_` and `EXPO_PUBLIC_` groups. None of the values below is a working
# credential: a copy that still holds a placeholder makes the process it belongs to refuse to
# start and name the variable, rather than run on an unusable secret.
#
# Generate the internal secrets once per environment; no provider supplies them:
#
#   openssl rand -base64 32   -> FIELD_ENCRYPTION_KEY
#   openssl rand -hex 32      -> JWT_SECRET, ANALYTICS_SALT, EMAIL_LOOKUP_PEPPER, EXPERIMENT_SALT
#   a decimal integer below the BN254 scalar field order (see docs/zk-proofs.md) -> NULLIFIER_SALT
#
# The rules are enforced at startup by the Zod schemas in
# packages/server-core/src/env/{common,api,workers,modes}.ts, one schema per process: each validates
# only its own scope, so a variable of another scope is never required of it, and a process
# refuses to start with one message listing every finding. APP_ENV, STRIPE_MODE, TELEPHONY_MODE
# and LLM_PROVIDER choose the posture, and a mode needs credentials only where it reaches a real
# provider: the defaults below (demo, mock, off, fake) reach none, which is what starts the local
# stack with nothing supplied.

# ---- Compose (local stack only) ----
# Password of the `postgres` service `docker-compose.yml` starts, on the loopback interface alone:
# it is not a credential for anything outside this machine.
POSTGRES_PASSWORD=tablemate
# Name of the compose project. Compose derives it from the checkout directory's own name, so
# checkouts running side by side stay separate; set it to override that with a name of your own.
# COMPOSE_PROJECT_NAME=
# Host side of each further port the stack publishes, at the `docker-compose.yml` default. A
# checkout that reserved a port block of its own — as the clone instructions require wherever
# several run at once — sets the ones it took here; `API_PORT` is in the api row below, and the
# service each of the rest publishes is in docs/operations.md.
WEB_PORT=8080
VENUE_CONSOLE_PORT=8090
ARTIFACTS_PORT=8070
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# ---- api and workers ----
# Deployment mode: test | demo | staging | production. `demo` is the local default. Fixtures load
# only in `test` and `demo`; the three test-only variables near the end of this file are refused
# in every other mode.
APP_ENV=demo
# PostgreSQL. A run outside compose reaches the host's own server; compose overrides this URL to the
# `postgres` service. `connection_limit` caps the connections one Prisma client opens — its default is
# `2 x CPU cores + 1`, more than the server accepts on a large host — and `pool_timeout` is the
# seconds a request waits for a free one before it fails. The bound matches the compose stack, where
# `postgres` allows 200 and the api, workers and migrate clients hold 20 each.
DATABASE_URL=postgresql://tablemate:tablemate@localhost:5432/tablemate?connection_limit=20&pool_timeout=10
# Redis: rate-limit counters, WebSocket fan-out and the BullMQ queues. `workers` needs its own Redis
# instance wherever several clones run at once, because queue names and job ids are fixed.
REDIS_URL=redis://localhost:6379
# AES-256-GCM key that encrypts email addresses, booking names and references, tier-3 profile
# fields and venue and lodging console secrets. Standard base64 of exactly 32 bytes.
FIELD_ENCRYPTION_KEY=<FIELD_ENCRYPTION_KEY>
# Id of the key above: 1-16 characters of [A-Za-z0-9_-]. Raise it together with a new key to rotate,
# which leaves every stored value decryptable.
FIELD_ENCRYPTION_KEY_ID=k1
# HMAC salt of the analytics actor hash: analytics carry a user id only as this hash, never raw.
ANALYTICS_SALT=<ANALYTICS_SALT>
# fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info
# Calls per city per local day, the time limit of each call in seconds, and the per-city
# language-model spend cap in USD per local day. A task over either cap is deferred to the next
# local day.
CAP_CALLS_PER_CITY_DAY=40
CAP_CALL_SECONDS=300
CAP_LLM_USD_PER_CITY_DAY=25
# Turns of one call's dialogue, each reserving its own share of the cap above before it is sent.
LLM_MAX_TURNS_PER_CALL=60
# off | simulator | twilio. `off` dials nothing and leaves every call task queued.
TELEPHONY_MODE=off
# fake | openai. `fake` needs no credential, so the stack and the automated suite run no model.
LLM_PROVIDER=fake
# Public base URL of the API. Its own scope row is `api`'s; `workers` reads it as well, because the
# TwiML and status-callback URLs a dispatched call carries are composed there. Both take it where the
# deployment provides it — the compose stack passes it to each — so a deployment that leaves it out
# still starts, and only the call-dispatch job fails without it.
API_PUBLIC_URL=http://localhost:3000
# Origin of the web client: the API's CORS allowlist and the base of a magic link's URL. `api` owns
# it, and `workers` reads it as well to build the link it mails. As above: the compose stack passes
# it, and its absence fails that delivery rather than the process's start.
WEB_ORIGIN=http://localhost:8080
# The seed (`pnpm db:seed`, a third process) reads APP_ENV, DATABASE_URL and the two
# field-encryption variables of this row, and nothing else.

# ---- api only ----
# Port the API listens on; API_PUBLIC_URL above must reach the same one.
API_PORT=3000
# Origin of the venue console, allowed to call the console routes.
VENUE_CONSOLE_ORIGIN=http://localhost:8090
# Signs the 15-minute access tokens that carry the caller's role and session.
JWT_SECRET=<JWT_SECRET>
# Peppers the HMAC lookup hash an email address is matched on, so the plaintext is never indexed.
EMAIL_LOOKUP_PEPPER=<EMAIL_LOOKUP_PEPPER>
# Salts the experiment assignment hash below, so a variant cannot be predicted from a user id.
EXPERIMENT_SALT=<EXPERIMENT_SALT>
# Share of new accounts assigned the `social` deposit framing, 0 to 1. Set 1.0 for 100% social if a
# control group is not wanted. Assigned once at account creation and never recomputed.
EXPERIMENT_SOCIAL_SHARE=0.5
# The published salt the proof nullifier hashes a booking reference with, as a decimal field
# element. The committed circuit fixtures are built with the salt 1, so a stack that verifies them
# in test mode sets 1; any other environment sets its own value, which devices read from the ZK
# configuration (`GET /v1/zk/config`) and proof verification compares against.
NULLIFIER_SALT=<NULLIFIER_SALT>
# Public base URL of the artefacts service: the witness generator and the proving key the clients
# download. The API holds the verification key alone.
ARTIFACTS_BASE_URL=http://localhost:8070
# Requests per minute one IP may make to the mutating routes, webhook routes excluded. The per-user
# limit is fixed at 60 per minute.
RATE_LIMIT_IP_PER_MIN=600
# Version of the terms and conditions a new account accepts, recorded on the account.
TERMS_VERSION=2026-11-04
# ConversationRelay sessions one API instance runs at once; further Twilio connections are refused.
VOICE_RELAY_MAX_SESSIONS=10
# Chat sockets one account may hold on one API instance; the socket that would exceed the allowance is
# closed with `WS_CLOSE.tooMany` (4429), which leaves the account's other sockets serving the chat.
CHAT_MAX_SOCKETS_PER_USER=5
# Reference lines the operator dashboard draws for the pilot: the targets for the lock rate and for
# the meetup completion rate. They are reported against, never enforced.
PILOT_LOCK_RATE_THRESHOLD=0.5
PILOT_COMPLETION_THRESHOLD=0.7
# mock | test | live. `mock` reaches the stateful proxy below and needs no Stripe key; `test` and
# `live` take the three keys further down, and live mode is accepted only in production.
STRIPE_MODE=mock

# ---- workers only ----
# SMTP endpoint a process outside compose delivers through, at the host's MAILPIT_SMTP_PORT
# (Mailpit captures the mail locally, and the end-to-end tests read the magic link from its API).
# The containerized workers dial the `mailpit` service instead, which `docker-compose.yml` pins.
SMTP_URL=smtp://localhost:1025
# From header of every message: an address, or a display name followed by the address in brackets.
EMAIL_FROM=Tablemate <no-reply@tablemate.local>
# Expo push access token. Leave it empty and push is off; web notifications still go by email.
EXPO_ACCESS_TOKEN=
# Overpass endpoint place and lodging ingestion queries.
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Daily FX table menu and ticket prices are converted to USD with. The last good table stays in use
# when a refresh fails.
FX_URL=https://open.er-api.com/v6/latest/USD
# Contact URL in the crawler's user agent, which reads `TablemateBot/1.0 (+<this URL>)`: how a
# site owner reaches the operator instead of blocking the bot.
CRAWLER_CONTACT_URL=https://example.org/tablemate-bot
# Comma-separated E.164 numbers a call may reach. Required outside production in twilio mode,
# because a non-production call reaches operator-owned numbers only.
CALL_ALLOWLIST=
# Legal-review gate for production calls: real calls stay blocked until this is true.
CALLS_PRODUCTION_APPROVED=false
# Days a settled meetup's financial records are kept before the purge (2557 = seven years).
FINANCIAL_RETENTION_DAYS=2557

# ---- STRIPE_MODE=mock (api) ----
# Base URL of the stateful stripe-proxy in front of stripe-mock (compose overrides it to the
# `stripe-proxy` service). This mode reads no Stripe key and needs none.
STRIPE_API_BASE=http://localhost:12100
# Where the stripe-proxy itself forwards to. Read by that service alone, never by the API, which is
# why it is commented out here; compose sets the `stripe-mock` host.
# STRIPE_MOCK_UPSTREAM=http://stripe-mock:12111

# ---- STRIPE_MODE=test, or live in production (api) ----
# Uncomment the three values and set STRIPE_MODE above. Outside production the secret key must
# start with sk_test_, and a key that does not is refused at startup; in production, `live` takes
# live keys and `test` still takes sk_test_ ones. The workers process reads no Stripe variable in
# any mode, because only the API holds a Stripe secret.
# STRIPE_SECRET_KEY=<STRIPE_SECRET_KEY>
# STRIPE_PUBLISHABLE_KEY=<STRIPE_PUBLISHABLE_KEY>
# STRIPE_WEBHOOK_SECRET=<from the stripe CLI: stripe listen --print-secret>

# ---- TELEPHONY_MODE=simulator (workers) ----
# Base URL of the scripted telephony simulator the automated suite injects in place of Twilio, as a
# process outside compose reaches it. The containerized workers dial the `voice-sim` service
# instead, which `docker-compose.yml` pins.
VOICE_SIM_URL=http://localhost:4010

# ---- TELEPHONY_MODE=twilio (api and workers) ----
# Uncomment these three and switch the mode above to twilio. Both credentials are read by `api`,
# which validates Twilio's signatures, and by `workers`, which dials. The caller id belongs to
# `workers` alone: a voice-capable E.164 number. Fill CALL_ALLOWLIST in the workers row as well when
# running outside production.
# TWILIO_ACCOUNT_SID=<TWILIO_ACCOUNT_SID>
# TWILIO_AUTH_TOKEN=<TWILIO_AUTH_TOKEN>
# TWILIO_FROM_NUMBER=<TWILIO_FROM_NUMBER>

# ---- LLM_PROVIDER=openai (api and workers) ----
# All four are required when LLM_PROVIDER=openai and unread when it is `fake`. LLM_MODEL must be one
# of gpt-4.1-mini, gpt-4.1 or gpt-5-mini, the models this adapter meters: any other value is
# refused at startup, because the per-city spend cap rests on that model's counted input tokens
# and its published price. Both prices are USD per million tokens, as the provider publishes them.
LLM_API_KEY=<LLM_API_KEY>
LLM_MODEL=<LLM_MODEL>
LLM_PRICE_INPUT_USD_PER_MTOK=<LLM_PRICE_INPUT_USD_PER_MTOK>
LLM_PRICE_OUTPUT_USD_PER_MTOK=<LLM_PRICE_OUTPUT_USD_PER_MTOK>

# ---- APP_ENV=test only ----
# A process whose APP_ENV is anything other than `test` refuses to start while one of these is
# present, which is what keeps test control and the test issuer out of a deployed stack.
# ZK_ALLOW_TEST_ISSUER=true
# TEST_CONTROL_TOKEN=<TEST_CONTROL_TOKEN>
# CRAWL_ALLOW_PRIVATE_HOSTS=localhost

# ---- apps/mobile build (validated in app.config.ts) ----
# API origin the client appends /v1 to: an origin, without a path. On a device or emulator, use the
# address the device can reach, such as the host's LAN address, not localhost.
EXPO_PUBLIC_API_URL=http://localhost:3000
# WebSocket base the client appends /v1/chat to: an origin, without a path.
EXPO_PUBLIC_WS_URL=ws://localhost:3000
# Publishable key of the same Stripe mode as STRIPE_MODE above, and the only Stripe material the
# app ever holds. Left empty for the `mock` default, where the card screens say payments are not
# configured; a secret key is refused at build time. Set a pk_test_ key to confirm a card.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# 1 only in the `bench` build that exposes the on-device proving benchmark and the artefact
# download it needs; every other build leaves it 0.
EXPO_PUBLIC_ZK_BENCH=0
# EAS project id, read by app.config.ts only when a build needs it.
# EAS_PROJECT_ID=

# ---- apps/venue-console build (validated in vite.config.ts) ----
# API origin the console appends /v1 to: an origin, without a path.
VITE_API_URL=http://localhost:3000
# Dev and preview port of the console. The default matches VENUE_CONSOLE_ORIGIN above; a run that
# reserves a port block of its own sets the port it took there instead.
# VITE_CONSOLE_PORT=8090
