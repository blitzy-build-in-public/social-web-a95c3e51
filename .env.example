# Tablemate environment template: `cp .env.example .env`, then replace every <PLACEHOLDER>. Docker Compose
# interpolates `.env` into the `postgres`, `api`, `workers` and `migrate` services, and the console's
# `vite.config.ts` and the app's `app.config.ts` read it at build time through their `VITE_` and `EXPO_PUBLIC_`
# groups. No value here is a working credential: a copy still holding a placeholder makes its process refuse to
# start and name the variable.
#
# Generate the internal secrets once per environment; no provider supplies them:
#
#   openssl rand -base64 32   -> FIELD_ENCRYPTION_KEY
#   openssl rand -hex 32      -> JWT_SECRET, ANALYTICS_SALT, EMAIL_LOOKUP_PEPPER, EXPERIMENT_SALT
#   a decimal integer below the BN254 scalar field order (see docs/zk-proofs.md) -> NULLIFIER_SALT
#
# Startup validation is the Zod schema of each process's own scope in
# packages/server-core/src/env/{common,api,workers,modes}.ts; a process refuses to start with one message listing
# every finding. APP_ENV, STRIPE_MODE, TELEPHONY_MODE and LLM_PROVIDER choose the posture, and the defaults below
# (demo, mock, off, fake) reach no provider.

# ---- Compose (local stack only) ----
# `postgres` password, on the loopback interface alone, and what compose uses for the project name when unset.
POSTGRES_PASSWORD=tablemate
# COMPOSE_PROJECT_NAME=
# Host side of the ports the stack publishes; a checkout that reserved a port block sets its own here.
WEB_PORT=8080
VENUE_CONSOLE_PORT=8090
ARTIFACTS_PORT=8070
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# ---- api and workers ----
# test | demo | staging | production; `demo` is the local default. Fixtures load only in test and demo.
APP_ENV=demo
# PostgreSQL, at the compose stack's bound: `postgres` allows 200 connections and each client holds 20.
DATABASE_URL=postgresql://tablemate:tablemate@localhost:5432/tablemate?connection_limit=20&pool_timeout=10
# Redis: rate-limit counters, WebSocket fan-out and the BullMQ queues; several clones need one each.
REDIS_URL=redis://localhost:6379
# AES-256-GCM key encrypting email addresses, booking details, tier-3 fields and console secrets: 32 bytes base64.
FIELD_ENCRYPTION_KEY=<FIELD_ENCRYPTION_KEY>
# Id of that key, 1-16 characters of [A-Za-z0-9_-]; raise it with a new key to rotate.
FIELD_ENCRYPTION_KEY_ID=k1
# HMAC salt of the analytics actor hash: analytics carry a user id only as this hash.
ANALYTICS_SALT=<ANALYTICS_SALT>
# fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info
# Caps per city per local day: calls, each call's seconds and language-model USD; over either, a task waits.
CAP_CALLS_PER_CITY_DAY=40
CAP_CALL_SECONDS=300
CAP_LLM_USD_PER_CITY_DAY=25
# Turns of one call's dialogue, each reserving its share of the cap above before it is sent.
LLM_MAX_TURNS_PER_CALL=60
# off | simulator | twilio. `off` dials nothing and leaves every call task queued.
TELEPHONY_MODE=off
# fake | openai. `fake` needs no credential, so the stack and the automated suite run no model.
LLM_PROVIDER=fake
# Public base URL of the API and of a call's TwiML and status-callback URLs; `api` and `workers` both read it.
API_PUBLIC_URL=http://localhost:3000
# Origin of the web client: the API's CORS allowlist and the base of a magic link `api` and `workers` build.
WEB_ORIGIN=http://localhost:8080
# The seed (`pnpm db:seed`, a third process) reads APP_ENV, DATABASE_URL and the two field-encryption variables.

# ---- api only ----
# Port the API listens on; API_PUBLIC_URL above must reach the same one.
API_PORT=3000
# Origin of the venue console, allowed to call the console routes.
VENUE_CONSOLE_ORIGIN=http://localhost:8090
# Signs the 15-minute access tokens carrying the caller's role and session.
JWT_SECRET=<JWT_SECRET>
# Peppers the HMAC lookup hash an email address is matched on, so the plaintext is never indexed.
EMAIL_LOOKUP_PEPPER=<EMAIL_LOOKUP_PEPPER>
# Salts the experiment assignment hash, so a variant cannot be predicted from a user id.
EXPERIMENT_SALT=<EXPERIMENT_SALT>
# Share of new accounts assigned the `social` deposit framing, 0 to 1; assigned once at account creation.
EXPERIMENT_SOCIAL_SHARE=0.5
# Decimal field element the nullifier hashes a booking reference with; the committed fixtures use the salt 1.
NULLIFIER_SALT=<NULLIFIER_SALT>
# Public base URL of the artefacts service, from which clients download the witness generator and the key.
ARTIFACTS_BASE_URL=http://localhost:8070
# Requests per minute one IP may make to the mutating routes, webhooks excluded; the per-user limit is 60.
RATE_LIMIT_IP_PER_MIN=600
# Version of the terms a new account accepts, recorded on the account.
TERMS_VERSION=2026-11-04
# ConversationRelay sessions one API instance runs at once; further Twilio connections are refused.
VOICE_RELAY_MAX_SESSIONS=10
# Chat sockets one account may hold per API instance; the socket over the allowance closes with 4429.
CHAT_MAX_SOCKETS_PER_USER=5
# Reference lines the dashboard draws for the pilot: the lock-rate and completion-rate targets, never enforced.
PILOT_LOCK_RATE_THRESHOLD=0.5
PILOT_COMPLETION_THRESHOLD=0.7
# mock | test | live. `mock` reaches the stateful proxy below and needs no key; live is production only.
STRIPE_MODE=mock

# ---- workers only ----
# SMTP endpoint for a process outside compose, at the host's MAILPIT_SMTP_PORT; containers dial `mailpit`.
SMTP_URL=smtp://localhost:1025
# From header of every message: an address, or a display name with the address in brackets.
EMAIL_FROM=Tablemate <no-reply@tablemate.local>
# Expo push access token. Empty leaves push off; web notifications still go by email.
EXPO_ACCESS_TOKEN=
# Overpass endpoint place and lodging ingestion queries.
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Daily FX table menu and ticket prices are converted with; the last good table stays in use on failure.
FX_URL=https://open.er-api.com/v6/latest/USD
# Contact URL in the crawler's user agent, for a site owner to reach the operator instead of blocking the bot.
CRAWLER_CONTACT_URL=https://example.org/tablemate-bot
# Comma-separated E.164 numbers a call may reach; required outside production in twilio mode.
CALL_ALLOWLIST=
# Legal-review gate for production calls: real calls stay blocked until this is true.
CALLS_PRODUCTION_APPROVED=false
# Days a settled meetup's financial records are kept before the purge (2557 = seven years).
FINANCIAL_RETENTION_DAYS=2557

# ---- STRIPE_MODE=mock (api) ----
# Base URL of the stateful stripe-proxy in front of stripe-mock; compose overrides it to that service.
STRIPE_API_BASE=http://localhost:12100
# Where the stripe-proxy forwards to, read by that service alone.
# STRIPE_MOCK_UPSTREAM=http://stripe-mock:12111

# ---- STRIPE_MODE=test, or live in production (api) ----
# Uncomment the three and set STRIPE_MODE above; outside production the secret key must start with sk_test_.
# STRIPE_SECRET_KEY=<STRIPE_SECRET_KEY>
# STRIPE_PUBLISHABLE_KEY=<STRIPE_PUBLISHABLE_KEY>
# STRIPE_WEBHOOK_SECRET=<from the stripe CLI: stripe listen --print-secret>

# ---- TELEPHONY_MODE=simulator (workers) ----
# Base URL of the scripted simulator a process outside compose reaches; containerized workers dial `voice-sim`.
VOICE_SIM_URL=http://localhost:4010

# ---- TELEPHONY_MODE=twilio (api and workers) ----
# Uncomment these three and switch the mode above to twilio: `api` validates Twilio's signatures and `workers`
# dials, the caller id being a voice-capable E.164 number. Fill CALL_ALLOWLIST in the workers row in production.
# TWILIO_ACCOUNT_SID=<TWILIO_ACCOUNT_SID>
# TWILIO_AUTH_TOKEN=<TWILIO_AUTH_TOKEN>
# TWILIO_FROM_NUMBER=<TWILIO_FROM_NUMBER>

# ---- LLM_PROVIDER=openai (api and workers) ----
# All four are required at LLM_PROVIDER=openai and unread at `fake`; LLM_MODEL must be gpt-4.1-mini, gpt-4.1 or
# gpt-5-mini, the metered models the per-city spend cap rests on. Both prices are USD per million tokens.
LLM_API_KEY=<LLM_API_KEY>
LLM_MODEL=<LLM_MODEL>
LLM_PRICE_INPUT_USD_PER_MTOK=<LLM_PRICE_INPUT_USD_PER_MTOK>
LLM_PRICE_OUTPUT_USD_PER_MTOK=<LLM_PRICE_OUTPUT_USD_PER_MTOK>

# ---- APP_ENV=test only ----
# A process whose APP_ENV is not `test` refuses to start while one of these is present.
# ZK_ALLOW_TEST_ISSUER=true
# TEST_CONTROL_TOKEN=<TEST_CONTROL_TOKEN>
# CRAWL_ALLOW_PRIVATE_HOSTS=localhost

# ---- apps/mobile build (validated in app.config.ts) ----
# API origin the client appends /v1 to, without a path; on a device or emulator use the host's LAN address.
EXPO_PUBLIC_API_URL=http://localhost:3000
# WebSocket base the client appends /v1/chat to, an origin without a path.
EXPO_PUBLIC_WS_URL=ws://localhost:3000
# Publishable key of the STRIPE_MODE above; empty in `mock` leaves the card screens reporting no payments.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# 1 only in the `bench` build, which exposes the on-device proving benchmark and its artefact download.
EXPO_PUBLIC_ZK_BENCH=0
# EAS project id, read by app.config.ts only when a build needs it.
# EAS_PROJECT_ID=

# ---- apps/venue-console build (validated in vite.config.ts) ----
# API origin the console appends /v1 to, an origin without a path.
VITE_API_URL=http://localhost:3000
# Dev and preview port of the console; the default matches VENUE_CONSOLE_ORIGIN above.
# VITE_CONSOLE_PORT=8090
